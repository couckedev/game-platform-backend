    "openapi-types": "^12.1.3",
    "@rspack/core": "^2.2.9",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
