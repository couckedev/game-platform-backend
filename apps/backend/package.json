  "type": "module",
  "scripts": {
    "check": "biome check",
    "check:write": "biome check",
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "acceptance": "vitest run --config ./vitest.config.acceptance.ts",
    "acceptance:watch": "vitest --config ./vitest.config.acceptance.ts",
    "unit": "vitest run --config ./vitest.config.unit.ts",
    "unit:watch": "vitest --config ./vitest.config.unit.ts",
    "openapi:generate": "tsx --env-file=.env scripts/openapi-spec-generator.ts",
    "database:migrations:generate": "for config in src/*/infrastructure/persistence/drizzle/drizzle.config.ts; do drizzle-kit generate --config=$config || exit 1; done",
    "database:migrations:run": "for config in src/*/infrastructure/persistence/drizzle/drizzle.config.ts; do drizzle-kit migrate --config=$config || exit 1; done",
    "database:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/swagger": "^9.9.3",
