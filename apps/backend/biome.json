{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "root": false,
    "extends": "//",
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        }
    },
    "linter": {
        "rules": {
            "style": {
                "useImportType": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "**/*.spec.ts",
                "tests/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}