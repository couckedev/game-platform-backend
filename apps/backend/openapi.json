{
  "openapi": "3.1.0",
  "info": {
    "title": "Game Platform API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "keycloak": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8080/realms/game-platform/protocol/openid-connect/auth",
            "tokenUrl": "http://localhost:8080/realms/game-platform/protocol/openid-connect/token",
            "scopes": {
              "openid": "OpenID Connect",
              "profile": "Profile",
              "email": "Email"
            }
          }
        }
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/players/me": {
      "get": {
        "summary": "Get current player",
        "responses": {
          "404": {
            "description": "Player not found",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "body": {
                          "type": "object",
                          "properties": {}
                        }
                      },
                      "required": [
                        "body"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/players": {
      "post": {
        "summary": "Register a player",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "nickname"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Player registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}